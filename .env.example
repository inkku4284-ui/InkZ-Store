# Set to the real HTTPS deployment origin before public launch; no trailing slash.
# This is public configuration, never a secret.
NEXT_PUBLIC_SITE_URL=

# ---- Store (server-side only; never prefix these with NEXT_PUBLIC_) ----
# off (unset) | test | live. "test" never works on Vercel Production; "live" needs live keys.
INKZ_SALES=
# Stripe secret or restricted key: sk_test_/rk_test_ with INKZ_SALES=test, sk_live_/rk_live_ with live.
STRIPE_SECRET_KEY=
# The 349 THB Price of Combat Framework in the same Stripe mode (test: price_1UT60N2L1yv98dz3gj1uOuiG)
STRIPE_COMBAT_PRICE_ID=
# base64 32-byte key that decrypts private/combat-framework.rbxm.enc (see scripts/encrypt-product.mjs)
COMBAT_FILE_KEY=
# Optional: https origin for Stripe return URLs (default: the Vercel deployment URL / http://localhost:3000)
STORE_ORIGIN=

# ---- Opt-in shadow order ledger (PR 1; checkout/download behavior is unchanged) ----
# off/unset | test | live. Live requires VERCEL_ENV=production; test is refused there.
INKZ_ORDER_LEDGER=
# Isolated Neon/Postgres database. Remote URLs must use sslmode=verify-full.
# Never share the live database with Preview or local development.
DATABASE_URL=
# Endpoint-specific signing secret, separate between test/live. Not the Stripe API key.
STRIPE_WEBHOOK_SECRET=

# ---- Secure guest delivery (PR 2 Preview evaluation only) ----
# off/unset preserves the existing live delivery. "test" requires BOTH store/ledger test configuration.
# "live" is refused in this staged release: email recovery and historical-customer migration must ship first.
# Enable only on the isolated PR2 Preview branch, after applying the committed migration.
INKZ_SECURE_DELIVERY=

# ---- Receipt-email recovery: test sender only until an owned sender domain is verified ----
# Enable only on the PR2 Preview branch. Never set these in Production for this version.
INKZ_RECOVERY_EMAIL=
RESEND_API_KEY=
# Private email used to register Resend. Must also be the Stripe Sandbox purchase's receipt email.
# Resend's onboarding@resend.dev sender cannot send to arbitrary customer addresses.
INKZ_RECOVERY_TEST_EMAIL=

# ---- Owner studio: requires migrated isolated ledger; off unless explicitly configured ----
# test | live, matching the ledger mode and Vercel environment. No customer registration.
INKZ_ADMIN=
# GitHub OAuth App: register the exact STORE_ORIGIN/api/admin/auth/callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Immutable numeric GitHub user IDs, comma-separated; no usernames or email matching.
INKZ_OWNER_GITHUB_IDS=
